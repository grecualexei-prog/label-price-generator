using System.Collections.ObjectModel;
using System.IO;
using System.Text.Json;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Media;
using BarcodeLib;
using Microsoft.Win32;

namespace LabelPriceGenerator;

public partial class MainWindow : Window
{
    private readonly ProductRepository _repository = new();
    private readonly ObservableCollection<Product> _products = new();

    public MainWindow()
    {
        InitializeComponent();

        ProductGrid.ItemsSource = _products;
        LoadProductCatalog();

        if (_products.Count == 0)
        {
            AddSampleProduct();
        }

        ProductGrid.SelectionChanged += ProductGrid_SelectionChanged;
        AddButton.Click += AddButton_Click;
        DeleteButton.Click += DeleteButton_Click;
        SaveButton.Click += SaveButton_Click;
        RefreshPreviewButton.Click += RefreshPreviewButton_Click;
        ExportPdfButton.Click += ExportPdfButton_Click;
        PrintButton.Click += PrintButton_Click;
        ClearFormButton.Click += ClearFormButton_Click;
        ImportCsvButton.Click += ImportCsvButton_Click;
        ExportCsvButton.Click += ExportCsvButton_Click;

        NameTextBox.TextChanged += (_, _) => UpdatePreview();
        PriceTextBox.TextChanged += (_, _) => UpdatePreview();
        PromoPriceTextBox.TextChanged += (_, _) => UpdatePreview();
        BarcodeTextBox.TextChanged += (_, _) => UpdatePreview();
        UnitTextBox.TextChanged += (_, _) => UpdatePreview();

        UpdatePreview();
    }

    private void LoadProductCatalog()
    {
        _products.Clear();
        foreach (var product in _repository.GetAll())
        {
            _products.Add(product);
        }

        if (_products.Count > 0)
        {
            ProductGrid.SelectedIndex = 0;
            LoadProductIntoForm(_products[0]);
        }
        else
        {
            ClearForm();
        }
    }

    private void ProductGrid_SelectionChanged(object sender, SelectionChangedEventArgs e)
    {
        if (ProductGrid.SelectedItem is Product product)
        {
            LoadProductIntoForm(product);
        }
    }

    private void AddButton_Click(object sender, RoutedEventArgs e)
    {
        var product = new Product
        {
            Name = "Produs nou",
            Price = 10m,
            PromoPrice = null,
            Unit = "buc",
            Barcode = DateTime.Now.Ticks.ToString(),
            Notes = "Creare nouă",
            CreatedAt = DateTime.Now
        };

        var inserted = _repository.Add(product);
        _products.Add(inserted);
        ProductGrid.SelectedItem = inserted;
        LoadProductIntoForm(inserted);
        UpdatePreview();
    }

    private void DeleteButton_Click(object sender, RoutedEventArgs e)
    {
        if (ProductGrid.SelectedItem is not Product product)
        {
            return;
        }

        _repository.Delete(product.Id);
        _products.Remove(product);

        if (_products.Count > 0)
        {
            ProductGrid.SelectedIndex = 0;
        }
        else
        {
            ClearForm();
        }
    }

    private void SaveButton_Click(object sender, RoutedEventArgs e)
    {
        if (ProductGrid.SelectedItem is not Product product)
        {
            return;
        }

        product.Name = NameTextBox.Text.Trim();
        product.Price = ParseDecimal(PriceTextBox.Text);
        product.PromoPrice = ParseNullableDecimal(PromoPriceTextBox.Text);
        product.Unit = UnitTextBox.Text.Trim();
        product.Barcode = BarcodeTextBox.Text.Trim();
        product.Notes = NotesTextBox.Text.Trim();

        _repository.Update(product);
        ProductGrid.Items.Refresh();
        UpdatePreview();
        MessageBox.Show("Produsul a fost salvat.", "Succes", MessageBoxButton.OK, MessageBoxImage.Information);
    }

    private void RefreshPreviewButton_Click(object sender, RoutedEventArgs e)
    {
        UpdatePreview();
    }

    private void ExportPdfButton_Click(object sender, RoutedEventArgs e)
    {
        var dialog = new SaveFileDialog
        {
            Filter = "PDF Files (*.pdf)|*.pdf",
            FileName = "etichetelor.pdf",
            DefaultExt = ".pdf"
        };

        if (dialog.ShowDialog() == true)
        {
            PdfExportService.ExportToPdf(_products.ToList(), dialog.FileName);
            MessageBox.Show($"Fișier exportat: {dialog.FileName}", "Succes", MessageBoxButton.OK, MessageBoxImage.Information);
        }
    }

    private void PrintButton_Click(object sender, RoutedEventArgs e)
    {
        MessageBox.Show("Tipărire directă către imprimantă va fi adăugată în varianta următoare. Pentru acum, exportul PDF este disponibil.", "Notă", MessageBoxButton.OK, MessageBoxImage.Information);
    }

    private void ClearFormButton_Click(object sender, RoutedEventArgs e)
    {
        ClearForm();
    }

    private void ImportCsvButton_Click(object sender, RoutedEventArgs e)
    {
        var dialog = new OpenFileDialog
        {
            Filter = "CSV Files (*.csv)|*.csv|All Files (*.*)|*.*",
            DefaultExt = ".csv"
        };

        if (dialog.ShowDialog() != true)
        {
            return;
        }

        var lines = File.ReadAllLines(dialog.FileName).Where(line => !string.IsNullOrWhiteSpace(line)).ToList();
        if (lines.Count == 0)
        {
            MessageBox.Show("Fișierul CSV este gol.", "Atenție", MessageBoxButton.OK, MessageBoxImage.Warning);
            return;
        }

        var importedCount = 0;
        foreach (var line in lines.Skip(1))
        {
            var columns = ParseCsvLine(line);
            if (columns.Count < 5)
            {
                continue;
            }

            var product = new Product
            {
                Name = columns[0].Trim(),
                Price = ParseDecimal(columns[1]),
                PromoPrice = columns.Count > 2 && !string.IsNullOrWhiteSpace(columns[2]) ? ParseDecimal(columns[2]) : null,
                Unit = columns[3].Trim(),
                Barcode = columns[4].Trim(),
                Notes = columns.Count > 5 ? columns[5].Trim() : string.Empty,
                CreatedAt = DateTime.Now
            };

            _repository.Add(product);
            importedCount++;
        }

        LoadProductCatalog();
        MessageBox.Show($"Au fost importate {importedCount} produse.", "Import CSV", MessageBoxButton.OK, MessageBoxImage.Information);
    }

    private void ExportCsvButton_Click(object sender, RoutedEventArgs e)
    {
        var dialog = new SaveFileDialog
        {
            Filter = "CSV Files (*.csv)|*.csv",
            FileName = "produse.csv",
            DefaultExt = ".csv"
        };

        if (dialog.ShowDialog() != true)
        {
            return;
        }

        var lines = new List<string>
        {
            "Nume,Pret,PretPromo,Unitate,CodBare,Observatii"
        };

        foreach (var product in _products)
        {
            lines.Add($"{EscapeCsv(product.Name)},{product.Price:0.00},{product.PromoPrice?.ToString("0.00") ?? string.Empty},{EscapeCsv(product.Unit)},{EscapeCsv(product.Barcode)},{EscapeCsv(product.Notes ?? string.Empty)}");
        }

        File.WriteAllLines(dialog.FileName, lines);
        MessageBox.Show($"Export CSV salvat: {dialog.FileName}", "Succes", MessageBoxButton.OK, MessageBoxImage.Information);
    }

    private void UpdatePreview()
    {
        var previewProduct = BuildPreviewFromForm();
        var image = LabelPreviewService.GeneratePriceLabel(previewProduct);
        PreviewImage.Source = image;
    }

    private Product BuildPreviewFromForm()
    {
        return new Product
        {
            Name = NameTextBox.Text.Trim(),
            Price = ParseDecimal(PriceTextBox.Text),
            PromoPrice = ParseNullableDecimal(PromoPriceTextBox.Text),
            Unit = UnitTextBox.Text.Trim(),
            Barcode = BarcodeTextBox.Text.Trim(),
            Notes = NotesTextBox.Text.Trim()
        };
    }

    private void LoadProductIntoForm(Product product)
    {
        NameTextBox.Text = product.Name;
        PriceTextBox.Text = product.Price.ToString("0.00");
        PromoPriceTextBox.Text = product.PromoPrice.HasValue ? product.PromoPrice.Value.ToString("0.00") : string.Empty;
        UnitTextBox.Text = product.Unit;
        BarcodeTextBox.Text = product.Barcode;
        NotesTextBox.Text = product.Notes ?? string.Empty;
        UpdatePreview();
    }

    private void ClearForm()
    {
        NameTextBox.Text = string.Empty;
        PriceTextBox.Text = string.Empty;
        PromoPriceTextBox.Text = string.Empty;
        UnitTextBox.Text = "buc";
        BarcodeTextBox.Text = string.Empty;
        NotesTextBox.Text = string.Empty;
        PreviewImage.Source = null;
    }

    private void AddSampleProduct()
    {
        var sample = _repository.Add(new Product
        {
            Name = "Paine alba",
            Price = 7.50m,
            PromoPrice = 6.90m,
            Unit = "buc",
            Barcode = "5901234123457",
            Notes = "Eticheta standard",
            CreatedAt = DateTime.Now
        });

        _products.Add(sample);
        ProductGrid.SelectedItem = sample;
        LoadProductIntoForm(sample);
    }

    private static List<string> ParseCsvLine(string line)
    {
        var result = new List<string>();
        var current = string.Empty;
        var inQuotes = false;

        foreach (var c in line)
        {
            if (c == '"')
            {
                if (inQuotes && nextIsQuote(line, line.IndexOf(c)))
                {
                    current += '"';
                }

                inQuotes = !inQuotes;
            }
            else if (c == ',' && !inQuotes)
            {
                result.Add(current);
                current = string.Empty;
            }
            else
            {
                current += c;
            }
        }

        result.Add(current);
        return result;
    }

    private static bool nextIsQuote(string line, int index)
    {
        var nextIndex = index + 1;
        return nextIndex < line.Length && line[nextIndex] == '"';
    }

    private static string EscapeCsv(string value)
    {
        if (value.Contains(',') || value.Contains('"') || value.Contains('\n'))
        {
            return $"\"{value.Replace("\"", "\"\"")}\"";
        }

        return value;
    }

    private static decimal ParseDecimal(string value)
    {
        return decimal.TryParse(value.Replace(',', '.'), out var result) ? result : 0m;
    }

    private static decimal? ParseNullableDecimal(string value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : ParseDecimal(value);
    }
}
