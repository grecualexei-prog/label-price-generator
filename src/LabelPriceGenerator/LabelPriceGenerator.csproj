using QuestPDF.Fluent;
using QuestPDF.Infrastructure;

namespace LabelPriceGenerator;

public static class PdfExportService
{
    public static void ExportToPdf(List<Product> products, string destinationPath)
    {
        Settings.License = LicenseType.Community;

        Document.Create(container =>
        {
            container.Page(page =>
            {
                page.Size(PageSizes.A4);
                page.Margin(24);
                page.DefaultTextStyle(x => x.FontSize(12));

                page.Content().Column(column =>
                {
                    foreach (var product in products)
                    {
                        column.Item().Border(1).Padding(12).Column(inner =>
                        {
                            inner.Item().Text(product.Name).FontSize(22).Bold();
                            inner.Item().Text($"Pret: {product.Price:0.00} lei");
                            if (product.PromoPrice.HasValue)
                            {
                                inner.Item().Text($"Promo: {product.PromoPrice.Value:0.00} lei");
                            }
                            inner.Item().Text($"Unitate: {product.Unit}");
                            inner.Item().Text($"Cod bare: {product.Barcode}");
                            inner.Item().Text(product.Notes ?? string.Empty);
                        });
                    }
                });
            });
        }).GeneratePdf(destinationPath);
    }
}
